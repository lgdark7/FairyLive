<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 1. Header Bar: Status & Scene Picker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tv_studio_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_badge"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="READY"
                    android:textColor="@color/fairy_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_stream_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="00:00:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_undo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_revert"
                    android:contentDescription="Undo" />

                <ImageButton
                    android:id="@+id/btn_redo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_rotate"
                    android:contentDescription="Redo" />

                <TextView
                    android:id="@+id/tv_active_scene_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scene: Gameplay"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Scene Quick Switch Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/layout_scene_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <!-- Dynamic chips inserted here -->
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 2. Visual Center: Live Preview Container -->
            <FrameLayout
                android:id="@+id/preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_preview_frame"
                android:padding="2dp">

                <com.fairylive.app.ui.studio.BroadcastPreviewView
                    android:id="@+id/broadcast_preview_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />

                <!-- Overlaid Performance HUD -->
                <LinearLayout
                    android:id="@+id/layout_hud_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_hud_overlay"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_hud_fps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FPS: 0.0"
                        android:textColor="@color/status_green"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_hud_bitrate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bitrate: 0 kbps"
                        android:textColor="@color/fairy_cyan"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_hud_audio_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio AU: 0/s"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_hud_codecs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Codecs: 2/2"
                        android:textColor="@color/fairy_purple_light"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Touch instructions hint -->
                <TextView
                    android:id="@+id/tv_touch_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_hud_overlay"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="Tap element to edit • Drag to move • Pinch/Corner to scale"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </FrameLayout>

            <!-- 3. Editor Action Bar (Add, Layers, Scenes, HUD) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <Button
                    android:id="@+id/btn_add_overlay"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/fairy_purple_dark"
                    android:text="+ Add"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_layers_toggle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/bg_card"
                    android:text="Layers"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_scenes_toggle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/bg_card"
                    android:text="Scenes"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_hud_toggle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/bg_card"
                    android:text="HUD"
                    android:textAllCaps="false"
                    android:textColor="@color/fairy_cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 4. Selected Element Quick Properties Bar -->
            <LinearLayout
                android:id="@+id/layout_selected_properties"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_selected_element_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Selected: Text Overlay"
                        android:textColor="@color/fairy_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_element_visibility"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="@color/bg_surface"
                        android:text="Hide"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_element_delete"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="@color/status_red"
                        android:text="Delete"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_element_layer_up"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="@color/bg_surface"
                        android:text="▲ Bring Forward"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_element_layer_down"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/bg_surface"
                        android:text="▼ Send Backward"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_element_edit_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_element_edit"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="@color/bg_surface"
                        android:text="✏️ Edit Content"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_element_opacity"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/bg_surface"
                        android:text="🌓 Opacity"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Collapsible Layer List Panel -->
            <LinearLayout
                android:id="@+id/layout_layer_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE LAYERS"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layout_layers_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">
                    <!-- Layer items inserted dynamically -->
                </LinearLayout>
            </LinearLayout>

            <!-- 6. Primary Stream Controls Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_toggle_camera"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/bg_card"
                    android:text="📷"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_toggle_mic"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/bg_card"
                    android:text="🎙️"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_go_live"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/fairy_cyan"
                    android:text="● GO LIVE"
                    android:textAllCaps="false"
                    android:textColor="@color/bg_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
