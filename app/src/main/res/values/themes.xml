<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Fairy Live Master Nocturnal Violet Theme Definition -->
    <style name="Theme.FairyLive" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_primary_variant</item>
        <item name="colorOnPrimary">@color/text_on_dark</item>

        <item name="colorSecondary">@color/accent_primary_variant</item>
        <item name="colorSecondaryVariant">@color/accent_primary</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowBackground">@color/bg_primary</item>

        <item name="bottomSheetDialogTheme">@style/Theme.FairyLive.BottomSheetDialog</item>
    </style>


    <style name="FairyBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
        <item name="behavior_peekHeight">280dp</item>
    </style>

    <!-- Editorial Typography Styles -->
    <style name="Typography.FairyLive.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Typography.FairyLive.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Typography.FairyLive.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Typography.FairyLive.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <style name="Typography.FairyLive.BodySecondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <style name="Typography.FairyLive.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Typography.FairyLive.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="DialogAnimation.FairyLive.BottomSheet" parent="Animation.Design.BottomSheetDialog">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>

    <style name="Theme.FairyLive.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="android:windowAnimationStyle">@style/DialogAnimation.FairyLive.BottomSheet</item>
        <item name="bottomSheetStyle">@style/FairyBottomSheetStyle</item>
    </style>
</resources>